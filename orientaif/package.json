{
  "name": "orienta-if",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node server/server.js",
    "start": "PORT=3001 node server/server.js",
    "dev:full": "node server/server.js & vite --host 0.0.0.0 --port 3000",
    "build:exe": "node scripts/build-exe.mjs",
    "build:portatil": "node scripts/build-portable.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
